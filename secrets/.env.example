# Copy this file to secrets/.env and fill in your keys.
# secrets/.env is gitignored — NEVER commit real credentials.

# Binance USDT-M futures keys (testnet or mainnet depending on network: setting)
# Obtain from https://testnet.binancefuture.com (testnet) or Binance API management (mainnet)
BINANCE_API_KEY=your_binance_api_key
BINANCE_SECRET_KEY=your_binance_secret_key

# Telegram bot (trade notifications) — token from BotFather, chat_id from your account
# Leave blank if Telegram notifications are disabled
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
